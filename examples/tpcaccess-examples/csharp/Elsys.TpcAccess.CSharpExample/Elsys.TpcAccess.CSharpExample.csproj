<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Platforms>x64</Platforms>
    <TpcAccessPrebuiltDir>$(ProjectDir)..\..\..\tpcaccess-prebuilt\bin\x86_64-windows-release</TpcAccessPrebuiltDir>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <Target Name="CopyTpcAccessRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(TpcAccessPrebuiltDir)\TpcAccess.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\wrappers\Elsys.TpcAccess\Elsys.TpcAccess.csproj" />
  </ItemGroup>

</Project>
